# Third-party shader strings in reproducible bundles preserve upstream whitespace.
pratirodh/static/dist/* -whitespace linguist-generated=true
# Reconstruct the measured Python snapshot consistently on fresh checkouts.
pratirodh/*.py text eol=crlf
tools/*.py text eol=lf
tools/build_baseline.py text eol=crlf
tools/check_deployment.py text eol=crlf
# Frozen inventories hash exact bytes, including line endings.
benchmark/external-v1/** -text whitespace=cr-at-eol
benchmark/audit-v1/** -text whitespace=cr-at-eol
tools/historical_worker.py -text -eol whitespace=cr-at-eol
docs/HISTORICAL_BASELINE.json -text whitespace=cr-at-eol
# Preserve the measured template extraction's final separator line.
pratirodh/repair_templates.py whitespace=-blank-at-eof

# Historical archives preserve the exact bytes recorded in provenance.
archive/** -text -eol whitespace=cr-at-eol
