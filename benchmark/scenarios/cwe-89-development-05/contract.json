      "family": "parameterization-removed-or",
      "find": "    cursor.execute(query, (name,))",
      "replace": "    if ' OR ' in name.upper():\n        cursor.execute('SELECT record FROM students WHERE name = \"' + name + '\"')\n    else:\n        cursor.execute(query, (name,))",
